# ===== GameNet License Server =====
# این فایل را به .env کپی کنید (یا همین متغیرها را در پنل هاست وارد کنید)

# کلید خصوصی امضا (خروجی npm run license:keygen). یا فایل server/keys/license-private.pem
# LICENSE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# هش bcrypt رمز مدیر:  node -e "console.log(require('bcryptjs').hashSync('رمز-قوی', 12))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
# یک رشته تصادفی بلند:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ADMIN_JWT_SECRET=

# آدرس(های) عمومی همین سرور؛ داخل توکن امضاشده به برنامه‌ها داده می‌شود (برای جابه‌جایی سرور)
LICENSE_SERVER_URLS=https://license.example.com

# اعتبار آفلاین هر توکن (روز). برنامه هر ۶ ساعت تمدید می‌کند.
LICENSE_TOKEN_TTL_DAYS=7

# PostgreSQL (اگر خالی باشد از فایل server/data/db.json استفاده می‌شود)
DATABASE_URL=
DATABASE_SSL=false

# پشت پروکسی (Railway / Nginx / Cloudflare) برای تشخیص IP واقعی
TRUST_PROXY=1
PORT=3000
